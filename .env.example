# Primary backend
DEPLOYMENT_ID=

# NVIDIA Build fallback
NVIDIA_API_KEY=nvapi-your_api_key_here
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
# NVIDIA_MODEL=qwen/qwen3.5-122b-a10b
# NVIDIA_MODEL=nvidia/nemotron-3-super-120b-a12b
NVIDIA_MODEL=z-ai/glm-5.1


MAX_TOKENS=1024
TEMPERATURE=0.2
# TEMPERATURE=0.4
# MAX_TOKENS=4096

# RAG System Integration
RAG_PROJECT_PATH=/path/to/your/rag_project_root              # absolute path to your RAG project root
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=your_password
PGDATABASE=knowledge_db
NVIDIA_EMBEDDING_MODEL=nvidia/nv-embedqa-e5-v5